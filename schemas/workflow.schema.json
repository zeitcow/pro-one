{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zeitcow/pro-one/schemas/workflow.schema.json",
  "title": "Pro-One Workflow Definition",
  "description": "Schema for defining supported legal-information workflows, boundaries, source needs, outputs, review status, and safety limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "status",
    "user_types",
    "legal_area",
    "topics",
    "jurisdiction",
    "scope",
    "sources",
    "intake",
    "process",
    "outputs",
    "safety",
    "review",
    "evaluation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable workflow identifier used by Pro-One.",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "description": "Human-readable workflow title."
    },
    "description": {
      "type": "string",
      "description": "Short explanation of the workflow and who it helps."
    },
    "status": {
      "type": "string",
      "description": "Current workflow maturity status.",
      "enum": [
        "proposed",
        "researched",
        "designed",
        "tested",
        "supported",
        "deprecated",
        "rejected"
      ]
    },
    "user_types": {
      "type": "array",
      "description": "User groups this workflow is designed to help.",
      "items": {
        "type": "string",
        "enum": [
          "self_represented_individual",
          "small_business_owner",
          "small_business_operator",
          "nonprofit_operator",
          "legal_aid_helper",
          "other"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "legal_area": {
      "type": "string",
      "description": "Primary legal area for the workflow."
    },
    "topics": {
      "type": "array",
      "description": "Specific topics covered by the workflow.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "jurisdiction": {
      "type": "object",
      "description": "Jurisdiction or institution the workflow applies to.",
      "additionalProperties": false,
      "required": [
        "country"
      ],
      "properties": {
        "country": {
          "type": "string",
          "description": "Country code or country name."
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "description": "State, province, or equivalent jurisdiction."
        },
        "locality": {
          "type": [
            "string",
            "null"
          ],
          "description": "County, city, district, or local jurisdiction if relevant."
        },
        "court": {
          "type": [
            "string",
            "null"
          ],
          "description": "Court name if the workflow is court-specific."
        },
        "agency": {
          "type": [
            "string",
            "null"
          ],
          "description": "Agency name if the workflow is agency-specific."
        },
        "jurisdiction_notes": {
          "type": "string",
          "description": "Notes about jurisdiction limits or uncertainty."
        }
      }
    },
    "scope": {
      "type": "object",
      "description": "What the workflow may and may not do.",
      "additionalProperties": false,
      "required": [
        "purpose",
        "legal_information_only",
        "includes",
        "excludes"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "description": "Plain-language purpose of the workflow."
        },
        "legal_information_only": {
          "type": "boolean",
          "const": true,
          "description": "This workflow provides legal information, not legal advice."
        },
        "includes": {
          "type": "array",
          "description": "Tasks or explanations the workflow may include.",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "excludes": {
          "type": "array",
          "description": "Tasks or decisions the workflow must not handle.",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "assumptions": {
          "type": "array",
          "description": "Assumptions that must be true for the workflow to fit.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "description": "Source requirements for the workflow.",
      "additionalProperties": false,
      "required": [
        "required_source_ids",
        "source_review_required"
      ],
      "properties": {
        "required_source_ids": {
          "type": "array",
          "description": "Approved or proposed source IDs required for this workflow.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "optional_source_ids": {
          "type": "array",
          "description": "Additional source IDs that may support the workflow.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source_review_required": {
          "type": "boolean",
          "description": "Whether source review is required before the workflow can be supported."
        },
        "source_notes": {
          "type": "string",
          "description": "Notes about source coverage, gaps, or limits."
        }
      }
    },
    "intake": {
      "type": "object",
      "description": "Information the workflow may ask from the user.",
      "additionalProperties": false,
      "required": [
        "required_inputs",
        "optional_inputs",
        "excluded_inputs",
        "collects_sensitive_data"
      ],
      "properties": {
        "required_inputs": {
          "type": "array",
          "description": "Information required to decide whether the workflow fits.",
          "items": {
            "type": "string"
          }
        },
        "optional_inputs": {
          "type": "array",
          "description": "Information that may improve usefulness but is not required.",
          "items": {
            "type": "string"
          }
        },
        "excluded_inputs": {
          "type": "array",
          "description": "Information this workflow should not request.",
          "items": {
            "type": "string"
          }
        },
        "collects_sensitive_data": {
          "type": "boolean",
          "description": "Whether the workflow collects sensitive personal, financial, health, immigration, or court-case information."
        },
        "data_minimization_notes": {
          "type": "string",
          "description": "How the workflow avoids collecting unnecessary data."
        }
      }
    },
    "process": {
      "type": "object",
      "description": "Court, agency, or legal process coverage.",
      "additionalProperties": false,
      "required": [
        "process_step_ids",
        "summary_steps",
        "deadline_handling"
      ],
      "properties": {
        "process_step_ids": {
          "type": "array",
          "description": "Process-step identifiers connected to this workflow.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "summary_steps": {
          "type": "array",
          "description": "Plain-language process steps the workflow may explain.",
          "items": {
            "type": "string"
          }
        },
        "deadline_handling": {
          "type": "string",
          "description": "How the workflow handles deadlines.",
          "enum": [
            "no_deadlines",
            "informational_only",
            "source_required",
            "human_review_required",
            "unsupported"
          ]
        },
        "process_notes": {
          "type": "string",
          "description": "Notes about process limits or needed review."
        }
      }
    },
    "outputs": {
      "type": "object",
      "description": "Outputs this workflow may generate.",
      "additionalProperties": false,
      "required": [
        "allowed_outputs",
        "prohibited_outputs",
        "document_types"
      ],
      "properties": {
        "allowed_outputs": {
          "type": "array",
          "description": "Output types this workflow may provide.",
          "items": {
            "type": "string",
            "enum": [
              "information_summary",
              "step_by_step_guide",
              "checklist",
              "document_outline",
              "document_draft",
              "form_guidance",
              "citation_summary",
              "referral_prompt"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prohibited_outputs": {
          "type": "array",
          "description": "Output types this workflow must not provide.",
          "items": {
            "type": "string",
            "enum": [
              "legal_opinion",
              "guaranteed_outcome",
              "deadline_calculation",
              "case_strategy",
              "final_filing_decision",
              "emergency_advice",
              "unsupported_document"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "document_types": {
          "type": "array",
          "description": "Document types this workflow may discuss, outline, or draft if allowed.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "output_notes": {
          "type": "string",
          "description": "Notes about output limits, review reminders, or document handling."
        }
      }
    },
    "safety": {
      "type": "object",
      "description": "Risk, refusal, and human-help rules.",
      "additionalProperties": false,
      "required": [
        "risk_level",
        "escalation_triggers",
        "refusal_triggers",
        "required_warnings"
      ],
      "properties": {
        "risk_level": {
          "type": "string",
          "description": "Workflow risk level.",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "escalation_triggers": {
          "type": "array",
          "description": "Signals that the user should be directed toward legal aid, court help, or a lawyer.",
          "items": {
            "type": "string"
          }
        },
        "refusal_triggers": {
          "type": "array",
          "description": "Signals that the workflow should refuse or narrow the request.",
          "items": {
            "type": "string"
          }
        },
        "required_warnings": {
          "type": "array",
          "description": "Warnings or limits that must appear in user-facing responses.",
          "items": {
            "type": "string"
          }
        },
        "safety_notes": {
          "type": "string",
          "description": "Additional safety notes."
        }
      }
    },
    "review": {
      "type": "object",
      "description": "Review status within Pro-One.",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_by",
        "reviewed_on"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "needs_review",
            "reviewed",
            "approved",
            "deprecated",
            "rejected"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reviewer name, handle, or role."
        },
        "reviewed_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date of review."
        },
        "review_notes": {
          "type": "string",
          "description": "Notes from workflow review."
        }
      }
    },
    "evaluation": {
      "type": "object",
      "description": "Testing requirements before the workflow can be supported.",
      "additionalProperties": false,
      "required": [
        "required_tests",
        "success_criteria",
        "known_failure_modes"
      ],
      "properties": {
        "required_tests": {
          "type": "array",
          "description": "Tests or evaluation categories required for this workflow.",
          "items": {
            "type": "string"
          }
        },
        "success_criteria": {
          "type": "array",
          "description": "What must be true for the workflow to pass review.",
          "items": {
            "type": "string"
          }
        },
        "known_failure_modes": {
          "type": "array",
          "description": "Known ways the workflow could fail or mislead users.",
          "items": {
            "type": "string"
          }
        },
        "evaluation_notes": {
          "type": "string",
          "description": "Additional evaluation notes."
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Additional notes."
    }
  }
}
